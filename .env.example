# Terrachrome configuration. `make dev` copies this to .env on first run and fills in SESSION_SECRET.
# The defaults run everything locally with fixture AI answers and a fake Google account: no keys needed.

# ---------------------------------------------------------------- AI
# mock = fixture answers (no API key needed); live = real Claude calls
LLM_MODE=mock
# Cheapest model that passes the retrieval benchmark (docs/RETRIEVAL_BENCHMARK.md)
MODEL_ID=claude-haiku-5-5
# Server key that pays for free-tier maps in live mode. Leave empty to allow only own-key (BYOK) maps.
ANTHROPIC_API_KEY=
# Hard cap on output tokens per map
MAX_OUTPUT_TOKENS=4000
# BYOK requests may search the web this many times per map (the model decides whether to search)
WEB_SEARCH_MAX_USES=3
# true lets free-tier requests use web search too, at the operator's cost
ADMIN_WEB_SEARCH=false
# Answer common indicators (population, rainfall, GDP per capita, ...) from the World Bank API, for free
DATASOURCES_ENABLED=true

# ---------------------------------------------------------------- Sign-in
# mock = fake local Google user; google = real Google sign-in (see README for the OAuth client setup)
AUTH_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs session and visitor cookies. Must be a long random string (required for AUTH_MODE=google).
SESSION_SECRET=change-me-to-a-long-random-string
# Days a sign-in lasts
SESSION_MAX_AGE_DAYS=30
# Keep true. Set false only if your browser refuses Secure cookies on http://localhost (older Safari).
COOKIE_SECURE=true
# Public URL in production, used to build the OAuth redirect URI, e.g. https://maps.example.com
PUBLIC_BASE_URL=

# ---------------------------------------------------------------- Storage
# Defaults to SQLite at backend/var/terrachrome.db. For Postgres: pip install "psycopg[binary]" and set e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/terrachrome

# ---------------------------------------------------------------- Quotas and cost control
# Free maps per rolling 24 hours (per browser, per signed-in account)
FREE_MAPS_PER_DAY=3
# Free maps per rolling 24 hours per IP address (raise for shared networks such as campuses)
FREE_MAPS_PER_IP_PER_DAY=3
# Free-tier spend per UTC day before free maps pause (BYOK keeps working)
DAILY_BUDGET_USD=1.00
RATE_LIMIT_PER_MINUTE=60
MAPS_RATE_LIMIT_PER_MINUTE=8
MAX_QUERY_CHARS=200
BYOK_ENABLED=true

# ---------------------------------------------------------------- Proxies
# Behind a reverse proxy: trust its client-IP header (only then is X-Forwarded-For read)
TRUST_PROXY_HEADERS=false
PROXY_IP_HEADER=x-forwarded-for
TRUSTED_PROXY_HOPS=1
# Optional: a separate salt keeps per-IP limits stable when SESSION_SECRET rotates
IP_HASH_SALT=

# ---------------------------------------------------------------- Cache
CACHE_TTL_DAYS=30
RECENT_CACHE_TTL_HOURS=24
