# marco.io configuration. `make dev` copies this to .env on first run and fills in SESSION_SECRET.
# There are no accounts and no server AI key: every map is made with the visitor's own OpenAI key, which
# they enter in the browser. The default mock mode needs no key at all.

# ---------------------------------------------------------------- AI
# mock = fixture answers (any well-formed key is accepted, nothing is billed); live = real OpenAI calls
LLM_MODE=mock
# The default: more accurate than gpt-6-luna, about 10x the cost (docs/RETRIEVAL_BENCHMARK.md)
OPENAI_MODEL_ID=gpt-6.1-terra
# Hard cap on output tokens per map
MAX_OUTPUT_TOKENS=4000
# The model may search the web when a question is about recent data (billed to the visitor's key)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_USES=3
# Answer common indicators (population, rainfall, GDP per capita, ...) from the World Bank API, with no AI call
DATASOURCES_ENABLED=true

# ---------------------------------------------------------------- Cookies
# Signs the anonymous visitor cookie (it owns the history drawer). Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# Keep true. Set false only if your browser refuses Secure cookies on http://localhost (older Safari).
COOKIE_SECURE=true

# ---------------------------------------------------------------- Storage
# Defaults to SQLite at backend/var/marco.db. For Postgres: pip install "psycopg[binary]" and set e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/marco

# ---------------------------------------------------------------- Abuse controls
RATE_LIMIT_PER_MINUTE=60
MAPS_RATE_LIMIT_PER_MINUTE=8
MAX_QUERY_CHARS=200

# ---------------------------------------------------------------- Proxies
# Behind a reverse proxy: trust its client-IP header (only then is X-Forwarded-For read)
TRUST_PROXY_HEADERS=false
PROXY_IP_HEADER=x-forwarded-for
TRUSTED_PROXY_HOPS=1
# Optional: a separate salt keeps per-IP rate limits stable when SESSION_SECRET rotates
IP_HASH_SALT=

# ---------------------------------------------------------------- Cache
CACHE_TTL_DAYS=30
RECENT_CACHE_TTL_HOURS=24

# ---------------------------------------------------------------- Advanced (the defaults are fine)
# Reasoning effort override (none | low | medium | high); unset uses the model profile's default
# (low on gpt-6.1-terra, which rejects none; none on gpt-6-luna)
# OPENAI_REASONING_EFFORT=low
# Seconds before an AI call is abandoned
# LLM_TIMEOUT_SECONDS=90
# Seconds before a World Bank request gives up (the question then goes to the AI)
# DATASOURCE_TIMEOUT_SECONDS=8
# Simulated AI latency in mock mode, in milliseconds
# MOCK_LATENCY_MS=1200
